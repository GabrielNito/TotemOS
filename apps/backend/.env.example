# Conexão PostgreSQL (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/totemos?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/totemos?schema=public"

# Autenticação JWT
JWT_SECRET="segredo-super-seguro-trocar-em-producao"

# Segredos HMAC do pareamento, gerar valores independentes e aleatórios
PAIRING_CODE_PEPPER="gerar-um-segredo-aleatorio-exclusivo"
DEVICE_TOKEN_PEPPER="gerar-outro-segredo-aleatorio-exclusivo"

# Porta da API NestJS
PORT=3001

# Mercado Pago Point API (Sandbox / Production Token)
MP_ACCESS_TOKEN="APP_USR-seu-token-mercado-pago"

# Origens permitidas no CORS (separadas por vírgula em produção)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,https://totem-os-dashboard.vercel.app"
